# Copy this file to .env.local and fill in your own key. Never commit .env.local.

# Required to call Claude. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-haiku-4-5 (cheapest current model, good fit for this
# small-document grounded Q&A task). Set to claude-sonnet-5 for higher-accuracy
# reasoning at ~2-2.5x the cost per question. See README.md "Model choice".
ANTHROPIC_MODEL=claude-haiku-4-5
